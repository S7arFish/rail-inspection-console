# =============================================================================
# Rail Inspection Console - backend settings (copy to `backend/.env` to override)
# =============================================================================
# Every key is OPTIONAL: the value shown is what the app uses when the variable
# is absent. Real environment variables always win over this file.
# Read by app/settings.py (a stdlib parser - no python-dotenv import).
# There are no credentials in this service; never add one to this file, and
# remember any key containing secret/token/password is redacted from logs.
# -----------------------------------------------------------------------------

# --- storage -----------------------------------------------------------------
# SQLite file location. Default = <repo>/data/rail_inspection.db (WAL mode, stdlib
# sqlite3 only). The default is resolved from wherever the project lives, and the
# parent directory is created automatically, so you normally leave this unset.
# Leave this commented out unless the database must live outside the repo: the
# default is derived from where the project is cloned, so a hard-coded path here
# would still point at the old machine.
#RIC_DATABASE_PATH=D:\somewhere\rail-inspection-console\data\rail_inspection.db

# --- parser definition -------------------------------------------------------
# THE configurable parser: field order, names, types, timestamp position/format,
# the OVER token and strict mode live in this YAML file. Field meanings are still
# partly unconfirmed, so pointing this elsewhere is how you re-label the stream
# without touching code. Default = <repo>/backend/config/parser.yaml
# Same rule: uncomment only to point at a different parser definition file.
#RIC_PARSER_CONFIG=D:\somewhere\rail-inspection-console\backend\config\parser.yaml

# --- CORS --------------------------------------------------------------------
# Comma separated origins allowed to call the API. Default is the Vite dev server.
# Use "*" to allow every origin (credentials are then disabled automatically).
RIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- serial defaults ----------------------------------------------------------
# Used when a POST /api/serial/connect omits the field. The physical sensor unit
# is a CP210x / Silicon Labs USB-UART bridge, which is what port auto-selection
# prefers; if `port` is omitted the service picks that port itself.
RIC_SERIAL_PORT=COM7
RIC_SERIAL_BAUDRATE=115200
# data bits: 5..8
RIC_SERIAL_BYTESIZE=8
# parity: N(one) E(ven) O(dd) M(arc) S(pace)
RIC_SERIAL_PARITY=N
# stop bits: 1, 1.5 or 2
RIC_SERIAL_STOPBITS=1
# flow control: none | hardware (=rtscts) | software (=xonxoff)
RIC_SERIAL_FLOWCONTROL=none

# --- serial service tuning -----------------------------------------------------
# Reader-thread readline timeout in milliseconds. A short timeout keeps
# disconnect() responsive while the daemon thread blocks on the port.
RIC_SERIAL_READ_TIMEOUT_MS=200

# --- websocket / snapshot ------------------------------------------------------
# How many recent measurements the first `snapshot` envelope carries, and how
# many concurrent /ws/live clients are accepted before new ones are refused.
RIC_WS_SNAPSHOT_SIZE=50
RIC_WS_MAX_CONNECTIONS=50

# --- misc ----------------------------------------------------------------------
# Reported by /api/health and the OpenAPI document.
RIC_APP_VERSION=0.1.0
