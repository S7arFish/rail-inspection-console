# Keep the console on fixture data until the FastAPI backend is running.
VITE_USE_MOCK=true

# Leave VITE_API_BASE_URL / VITE_WS_URL unset in development: vite.config.ts
# proxies /api and /ws to VITE_API_PROXY_TARGET, so the backend needs no CORS
# and the browser only ever talks to the dev origin.
#VITE_API_BASE_URL=/api
#VITE_WS_URL=ws://127.0.0.1:8000/ws/live

VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_PORT=5173
